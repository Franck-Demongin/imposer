import { Button, ComboBox, CheckBox, LineEdit, VerticalBox, HorizontalBox, ScrollView, Palette } from "std-widgets.slint";

export struct PreviewPlacement {
    x: float,
    y: float,
    w: float,
    h: float
}

export global Theme {
    out property <length> spacing-s: 6px;
    out property <length> spacing-m: 12px;
    out property <length> spacing-l: 20px;
    out property <length> radius: 6px;
    out property <length> font-secondary: 11px;
    out property <length> font-small: 12px;
}

component Card inherits Rectangle {
    in property <string> title: "";

    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: Theme.radius;

    VerticalLayout {
        padding: Theme.spacing-m;
        spacing: Theme.spacing-m;
        alignment: start;

        if root.title != "": Text {
            text: root.title;
            font-size: 14px;
            font-weight: 600;
            color: Palette.alternate-foreground;
        }

        @children
    }
}

export component AppWindow inherits Window {
    title: "Imposer";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 520px;

    in property <string> status: "Prêt.";
    in property <int> status-level: 0;
    in property <bool> busy: false;
    in property <string> source-1: "";
    in property <string> source-2: "";

    in-out property <string> output-dir: "";
    in-out property <string> output-name: "";

    in-out property <int> sheet-index: 0;
    in-out property <int> sheet-orientation-index: 0;
    in-out property <bool> rotate-verso: false;
    in-out property <string> bleed-text: "2.0";
    in-out property <string> safety-text: "5.0";
    in-out property <bool> rotate-copies: true;

    in property <float> preview-width: 0;
    in property <float> preview-height: 0;
    in property <[PreviewPlacement]> preview-placements: [];

    callback browse-source-one();
    callback browse-source-two();
    callback remove-last-source();
    callback browse-output-directory();
    callback generate();
    callback refresh-preview();

    VerticalLayout {
        padding: Theme.spacing-m;
        spacing: Theme.spacing-s;
        alignment: stretch;

        HorizontalLayout {
            spacing: Theme.spacing-m;
            vertical-stretch: 1;
            alignment: center;

            ScrollView {
                horizontal-stretch: 1;
                max-width: 720px;
                min-width: 320px;

                VerticalLayout {
                    spacing: Theme.spacing-m;
                    alignment: start;

                    Card {
                        title: "Sources (max. 2)";
                        GridLayout {
                            spacing-horizontal: Theme.spacing-s;
                            spacing-vertical: Theme.spacing-s;

                            Text { text: "Recto"; row: 0; col: 0; vertical-alignment: center; }
                            LineEdit { text: root.source-1; read-only: true; row: 0; col: 1; horizontal-stretch: 1; }
                            Button { text: "Parcourir…"; enabled: !root.busy; row: 0; col: 2; clicked => { root.browse-source-one(); } }

                            Text { text: "Verso"; row: 1; col: 0; vertical-alignment: center; }
                            LineEdit { text: root.source-2; read-only: true; row: 1; col: 1; horizontal-stretch: 1; }
                            Button { text: "Parcourir…"; enabled: !root.busy; row: 1; col: 2; clicked => { root.browse-source-two(); } }
                        }
                        HorizontalLayout {
                            alignment: end;
                            Button { text: "Retirer la dernière"; enabled: !root.busy; clicked => { root.remove-last-source(); } }
                        }
                    }

                    Card {
                        title: "Sortie";
                        GridLayout {
                            spacing-horizontal: Theme.spacing-s;
                            spacing-vertical: Theme.spacing-s;

                            Text { text: "Dossier"; row: 0; col: 0; vertical-alignment: center; }
                            LineEdit { text <=> root.output-dir; row: 0; col: 1; horizontal-stretch: 1; }
                            Button { text: "Dossier…"; enabled: !root.busy; row: 0; col: 2; clicked => { root.browse-output-directory(); } }

                            Text { text: "Fichier"; row: 1; col: 0; vertical-alignment: center; }
                            LineEdit { text <=> root.output-name; row: 1; col: 1; horizontal-stretch: 1; }
                        }
                    }

                    Card {
                        title: "Options";
                        VerticalLayout {
                            spacing: Theme.spacing-s;
                            alignment: start;

                            HorizontalLayout {
                                spacing: Theme.spacing-m;
                                VerticalLayout {
                                    spacing: Theme.spacing-s;
                                    Text { text: "Feuille"; }
                                    ComboBox {
                                        model: ["A4", "A3", "SRA3"];
                                        current-index <=> root.sheet-index;
                                    }
                                }
                                VerticalLayout {
                                    spacing: Theme.spacing-s;
                                    Text { text: "Orientation feuille"; }
                                    ComboBox {
                                        model: ["Auto", "Portrait", "Paysage"];
                                        current-index <=> root.sheet-orientation-index;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing-m;
                                VerticalLayout {
                                    spacing: Theme.spacing-s;
                                    Text { text: "Bord perdu (mm)"; }
                                    LineEdit { text <=> root.bleed-text; preferred-width: 90px; horizontal-stretch: 0; }
                                }
                                VerticalLayout {
                                    spacing: Theme.spacing-s;
                                    Text { text: "Marge sécurité (mm)"; }
                                    LineEdit { text <=> root.safety-text; preferred-width: 90px; horizontal-stretch: 0; }
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing-m;
                                CheckBox { text: "Rotation des versos"; checked <=> root.rotate-verso; }
                                CheckBox { text: "Rotation des poses"; checked <=> root.rotate-copies; }
                            }
                        }
                    }
                }
            }

            ScrollView {
                preferred-width: 320px;
                max-width: 380px;
                min-width: 260px;
                horizontal-stretch: 0;

                VerticalLayout {
                    spacing: Theme.spacing-m;
                    alignment: start;

                    Card {
                        title: "Prévisualisation";
                        preview-box := Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            height: root.preview-width > 0.0 ? (preview-box.width * (root.preview-height / root.preview-width)) : 0px;
                            background: Palette.control-background;
                            border-width: 1px;
                            border-color: Palette.border;
                            border-radius: Theme.radius;
                            clip: true;

                            for placement in root.preview-placements: Rectangle {
                                x: placement.x * (preview-box.width / max(root.preview-width, 1.0));
                                y: placement.y * (preview-box.width / max(root.preview-width, 1.0));
                                width: placement.w * (preview-box.width / max(root.preview-width, 1.0));
                                height: placement.h * (preview-box.width / max(root.preview-width, 1.0));
                                background: #33cccc33;
                                border-width: 1px;
                                border-color: #33ccff;
                            }
                        }
                    }

                    Card {
                        title: "Récapitulatif";
                        VerticalLayout {
                            spacing: Theme.spacing-s;
                            Text { text: "Source 1 : " + (root.source-1 == "" ? "(aucune)" : root.source-1); wrap: no-wrap; overflow: elide; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Source 2 : " + (root.source-2 == "" ? "(aucune)" : root.source-2); wrap: no-wrap; overflow: elide; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Dossier : " + (root.output-dir == "" ? "(non défini)" : root.output-dir); wrap: no-wrap; overflow: elide; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Fichier : " + (root.output-name == "" ? "(non défini)" : root.output-name); wrap: no-wrap; overflow: elide; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Feuille : " + (root.sheet-index == 0 ? "A4" : (root.sheet-index == 1 ? "A3" : "SRA3")); font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Orientation feuille : " + (root.sheet-orientation-index == 0 ? "Auto" : (root.sheet-orientation-index == 1 ? "Portrait" : "Paysage")); font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Rotation des versos : " + (root.rotate-verso ? "Oui" : "Non"); font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Bord perdu : " + root.bleed-text + " mm"; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Marge sécurité : " + root.safety-text + " mm"; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Rotation des poses : " + (root.rotate-copies ? "Oui" : "Non"); font-size: Theme.font-small; color: Palette.alternate-foreground; }
                        }
                    }

                    Text {
                        text: "- Max. 2 sources sélectionnables.\n- Plusieurs sources : seule la première page de chaque source est utilisée.\n- La prévisualisation utilise la première source disponible.\n- Les dimensions doivent correspondre à 0,5 pt près.";
                        font-size: Theme.font-secondary;
                        color: Palette.alternate-foreground;
                        wrap: word-wrap;
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                spacing: Theme.spacing-s;
                alignment: center;

                Button {
                    width: 220px;
                    text: root.busy ? "Génération…" : "Générer";
                    enabled: !root.busy;
                    primary: true;
                    clicked => { root.generate(); }
                }

                Text {
                    text: root.status;
                    overflow: elide;
                    horizontal-stretch: 1;
                    font-size: Theme.font-small;
                    color: root.status-level == 2 ? #c42b1c : (root.status-level == 1 ? #107c10 : Palette.foreground);
                }
            }
        }

    }

    changed sheet-index => { root.refresh-preview(); }
    changed sheet-orientation-index => { root.refresh-preview(); }
    changed rotate-verso => { root.refresh-preview(); }
    changed bleed-text => { root.refresh-preview(); }
    changed safety-text => { root.refresh-preview(); }
    changed rotate-copies => { root.refresh-preview(); }
}