import { Button, ComboBox, CheckBox, LineEdit, VerticalBox, HorizontalBox, ScrollView, Palette } from "std-widgets.slint";

export struct PreviewPlacement {
    x: float,
    y: float,
    w: float,
    h: float
}

export struct SnackbarItem {
    text: string,
    level: int,
    id: int,
}

component Snackbar inherits Rectangle {
    in property <string> text: "";
    in property <int> level: 0;
    in property <int> id: 0;

    callback close-requested();

    background: self.level == 2 ? #e53935 : (self.level == 1 ? #f08c00 : #2e9f54);
    border-color: self.level == 2 ? #9b000e : (self.level == 1 ? #a66100 : #1d6f3a);
    border-width: 1px;
    border-radius: Theme.corner-radius;
    height: self.preferred-height;

    HorizontalBox {
        padding: Theme.spacing;
        spacing: Theme.spacing;
        alignment: stretch;

        Text {
            text: root.text;
            color: root.level == 2 ? #ffffff : (root.level == 1 ? #111111 : #ffffff);
            wrap: word-wrap;
            horizontal-alignment: left;
            vertical-alignment: top;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 24px;
            height: 24px;
            horizontal-stretch: 0;
            border-radius: 12px;
            background: root.level == 2 ? #9b000e : (root.level == 1 ? #a66100 : #1d6f3a);

            Image {
                x: 5px;
                y: 5px;
                width: 14px;
                height: 14px;
                source: @image-url("../assets/icons/ui/close.svg");
                image-fit: contain;
            }

            TouchArea {
                width: 24px;
                height: 24px;
                clicked => {
                    root.close-requested();
                }
            }
        }
    }
}

export global Theme {
    out property <length> spacing: 8px;
    out property <length> corner-radius: 6px;
    out property <length> font-secondary: 11px;
    out property <length> font-small: 12px;

    out property <length> window-preferred-width: 1100px;
    out property <length> window-preferred-height: 720px;
    out property <length> window-min-width: 760px;
    out property <length> window-min-height: 520px;
}

component Card inherits Rectangle {
    in property <string> title: "";

    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: Theme.corner-radius;

    VerticalLayout {
        padding: Theme.spacing;
        spacing: Theme.spacing;
        alignment: start;

        if root.title != "": Text {
            text: root.title;
            font-size: 14px;
            font-weight: 600;
            color: Palette.alternate-foreground;
        }

        @children
    }
}

component PopupButtonRow inherits HorizontalLayout {
    spacing: Theme.spacing;
    padding-top: Theme.spacing;
    alignment: end;
    vertical-stretch: 0;

    @children
}

component ModalDialog inherits FocusScope {
    in property <length> dialog-width: 420px;
    in property <length> dialog-height: 140px;
    callback close();
    z: 1000;
    width: 100%;
    height: 100%;
    enabled: true;
    focus-on-click: true;
    focus-on-tab-navigation: true;

    init => { self.focus(); }

    capture-key-pressed(event) => {
        if (event.text == Key.Escape) {
            root.close();
            return accept;
        }
        return reject;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;

        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: default;
            clicked => { }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.dialog-width;
        height: root.dialog-height;
        background: Palette.alternate-background;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: Theme.corner-radius;

        VerticalLayout {
            padding: Theme.spacing;
            spacing: Theme.spacing;
            alignment: stretch;

            @children
        }
    }
}

export component AppWindow inherits Window {
    in property <string> app-title: "Imposer";
    title: root.app-title;
    icon: @image-url("../assets/icons/imposer-256.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 520px;

    in property <bool> busy: false;

    in property <[SnackbarItem]> snackbar-items: [];
    in-out property <string> source-1: "";
    in-out property <string> source-2: "";

    in-out property <string> output-path: "";

    in-out property <int> sheet-index: 0;
    in-out property <bool> sheet-selection-lock: false;
    in-out property <bool> sheet-selection-suppress-next: false;
    in-out property <int> sheet-orientation-index: 0;
    in-out property <bool> rotate-verso: false;
    in-out property <string> bleed-text: "2.0";
    in-out property <string> safety-text: "5.0";
    in-out property <bool> rotate-copies: true;

    in property <[string]> sheet-options: ["A4", "A3", "SRA3", "Personnalisé"];
    in-out property <int> previous-sheet-index: 0;
    in-out property <string> sheet-width-mm: "210.0";
    in-out property <string> sheet-height-mm: "297.0";
    in property <string> sheet-summary: "A4 (21,0 x 29,7 cm)";
    in-out property <string> selected-sheet-name: "A4";
    in-out property <bool> sheet-save-visible: false;
    in-out property <bool> sheet-delete-visible: false;

    in-out property <bool> custom-open: false;
    in-out property <string> custom-width-mm: "210.0";
    in-out property <string> custom-height-mm: "297.0";
    in-out property <string> custom-error: "";

    in-out property <bool> save-open: false;
    in-out property <string> preset-name-text: "";
    in-out property <bool> delete-open: false;
    in-out property <string> delete-preset-name: "";
    in-out property <string> delete-preset-error: "";
    in-out property <string> preset-save-error: "";

    in property <float> preview-width: 0;
    in property <float> preview-height: 0;
    in property <[PreviewPlacement]> preview-placements: [];

    in property <string> last-output-path: "";
    in property <bool> output-ready: false;

    callback browse-source-one();
    callback browse-source-two();
    callback close-snackbar(int);
    callback browse-output();
    callback generate();
    callback open-output-file();
    callback open-output-folder();
    callback refresh-preview();
    callback sheet-selection-changed(int);
    callback custom-confirm();
    callback custom-cancel();
    callback save-preset-requested();
    callback save-preset-confirm();
    callback delete-preset-requested();
    callback delete-preset-confirm();
    Rectangle {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: Theme.spacing;
            spacing: Theme.spacing;
            alignment: stretch;

            HorizontalBox {
                vertical-stretch: 0;
                alignment: stretch;
                spacing: Theme.spacing;

                Image {
                    source: @image-url("../assets/icons/imposer-64.png");
                    width: 48px;
                    height: 48px;
                    image-fit: contain;
                }

                VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    Text {
                        text: "Imposer";
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Imposition de documents PDF, PNG, JPEG et PSD";
                        font-size: 12px;
                        color: Palette.foreground;
                        horizontal-alignment: left;
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing;
                vertical-stretch: 1;

            ScrollView {
                horizontal-stretch: 3;
                min-width: 420px;
                content-width: self.visible-width;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                VerticalLayout {
                    spacing: Theme.spacing;
                    alignment: start;
                    horizontal-stretch: 1;

                    Card {
                        title: "Sources (max. 2)";
                        GridLayout {
                            spacing-horizontal: Theme.spacing;
                            spacing-vertical: Theme.spacing;

                            Text { text: "Recto"; row: 0; col: 0; vertical-alignment: center; }
                            LineEdit { text <=> root.source-1; row: 0; col: 1; horizontal-stretch: 1; edited => { root.refresh-preview(); } }
                            Button { text: "Parcourir…"; icon: @image-url("../assets/icons/ui/file-open.svg"); icon-size: 16px; colorize-icon: true; enabled: !root.busy; row: 0; col: 2; min-width: 100px; clicked => { root.browse-source-one(); } }

                            Text { text: "Verso"; row: 1; col: 0; vertical-alignment: center; }
                            LineEdit { text <=> root.source-2; row: 1; col: 1; horizontal-stretch: 1; edited => { root.refresh-preview(); } }
                            Button { text: "Parcourir…"; icon: @image-url("../assets/icons/ui/file-open.svg"); icon-size: 16px; colorize-icon: true; enabled: !root.busy; row: 1; col: 2; min-width: 100px; clicked => { root.browse-source-two(); } }
                        }
                    }

                    Card {
                        title: "Sortie";
                        GridLayout {
                            spacing-horizontal: Theme.spacing;
                            spacing-vertical: Theme.spacing;

                            Text { text: "Sortie"; row: 0; col: 0; vertical-alignment: center; }
                            LineEdit { text <=> root.output-path; row: 0; col: 1; horizontal-stretch: 1; }
                            Button { text: "Parcourir…"; icon: @image-url("../assets/icons/ui/folder-open.svg"); icon-size: 16px; colorize-icon: true; enabled: !root.busy; row: 0; col: 2; min-width: 100px; clicked => { root.browse-output(); } }
                        }
                    }

                    Card {
                        title: "Options";
                        GridLayout {
                            spacing-horizontal: Theme.spacing;
                            spacing-vertical: Theme.spacing;

                            Text { text: "Feuille — " + root.selected-sheet-name; row: 0; col: 0; }
                            Text { text: "Orientation feuille"; row: 0; col: 1; }

                            HorizontalLayout {
                                row: 1; col: 0; spacing: Theme.spacing;
                                ComboBox {
                                    model: root.sheet-options;
                                    current-index <=> root.sheet-index;
                                    horizontal-stretch: 1;
                                }
                                if root.sheet-save-visible: Button {
                                    text: "";
                                    icon: @image-url("../assets/icons/ui/document-save.svg");
                                    icon-size: 16px;
                                    colorize-icon: true;
                                    enabled: !root.busy;
                                    min-width: 30px; min-height: 30px;
                                    clicked => { root.save-preset-requested(); }
                                }
                                if root.sheet-delete-visible: Button {
                                    text: "";
                                    icon: @image-url("../assets/icons/ui/delete.svg");
                                    icon-size: 16px;
                                    colorize-icon: true;
                                    enabled: !root.busy;
                                    min-width: 30px; min-height: 30px;
                                    clicked => { root.delete-preset-requested(); }
                                }
                            }
                            ComboBox {
                                model: ["Auto", "Portrait", "Paysage"];
                                current-index <=> root.sheet-orientation-index;
                                row: 1; col: 1; horizontal-stretch: 1;
                            }

                            Text { text: "Bord perdu (mm)"; row: 2; col: 0; }
                            Text { text: "Marge sécurité (mm)"; row: 2; col: 1; }

                            LineEdit { text <=> root.bleed-text; row: 3; col: 0; horizontal-stretch: 1; min-width: 90px; }
                            LineEdit { text <=> root.safety-text; row: 3; col: 1; horizontal-stretch: 1; min-width: 90px; }

                            CheckBox { text: "Rotation des versos"; checked <=> root.rotate-verso; row: 4; col: 0; }
                            CheckBox { text: "Rotation des poses"; checked <=> root.rotate-copies; row: 4; col: 1; }
                        }
                    }
                }
            }

            ScrollView {
                horizontal-stretch: 2;
                min-width: 300px;
                max-width: 640px;
                preferred-width: 320px;
                content-width: self.visible-width;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                VerticalLayout {
                    spacing: Theme.spacing;
                    alignment: start;
                    horizontal-stretch: 1;

                    Card {
                        title: "Prévisualisation";
                        preview-box := Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            height: root.preview-width > 0.0 ? (preview-box.width * (root.preview-height / root.preview-width)) : 0px;
                            background: Palette.control-background;
                            border-width: 1px;
                            border-color: Palette.border;
                            border-radius: Theme.corner-radius;
                            clip: true;

                            for placement in root.preview-placements: Rectangle {
                                x: placement.x * (preview-box.width / max(root.preview-width, 1.0));
                                y: placement.y * (preview-box.width / max(root.preview-width, 1.0));
                                width: placement.w * (preview-box.width / max(root.preview-width, 1.0));
                                height: placement.h * (preview-box.width / max(root.preview-width, 1.0));
                                background: #33cccc33;
                                border-width: 1px;
                                border-color: #33ccff;
                            }
                        }
                    }

                    Card {
                        title: "Récapitulatif";
                        VerticalLayout {
                            spacing: Theme.spacing;
                            Text { text: "Source 1 : " + (root.source-1 == "" ? "(aucune)" : root.source-1); wrap: no-wrap; overflow: elide; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Source 2 : " + (root.source-2 == "" ? "(aucune)" : root.source-2); wrap: no-wrap; overflow: elide; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Sortie : " + (root.output-path == "" ? "(non défini)" : root.output-path); wrap: no-wrap; overflow: elide; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Feuille : " + root.sheet-summary; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Orientation feuille : " + (root.sheet-orientation-index == 0 ? "Auto" : (root.sheet-orientation-index == 1 ? "Portrait" : "Paysage")); font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Rotation des versos : " + (root.rotate-verso ? "Oui" : "Non"); font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Bord perdu : " + root.bleed-text + " mm"; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Marge sécurité : " + root.safety-text + " mm"; font-size: Theme.font-small; color: Palette.alternate-foreground; }
                            Text { text: "Rotation des poses : " + (root.rotate-copies ? "Oui" : "Non"); font-size: Theme.font-small; color: Palette.alternate-foreground; }
                        }
                    }

                    Rectangle {
                        height: Theme.spacing;
                    }

                    Text {
                        text: "- Max. 2 sources sélectionnables.\n- Plusieurs sources : seule la première page de chaque source est utilisée.\n- La prévisualisation utilise la première source disponible.\n- Les dimensions doivent correspondre à 0,5 pt près.";
                        font-size: Theme.font-secondary;
                        color: Palette.alternate-foreground;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            padding-top: Theme.spacing;

            if root.output-ready: Button {
                text: "Ouvrir le fichier";
                icon: @image-url("../assets/icons/ui/file-open.svg");
                icon-size: 16px;
                colorize-icon: true;
                enabled: !root.busy;
                min-width: 150px;
                clicked => { root.open-output-file(); }
            }
            if root.output-ready: Button {
                text: "Ouvrir le dossier";
                icon: @image-url("../assets/icons/ui/folder-open.svg");
                icon-size: 16px;
                colorize-icon: true;
                enabled: !root.busy;
                min-width: 150px;
                clicked => { root.open-output-folder(); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: root.busy ? "Génération…" : "Générer";
                enabled: !root.busy;
                primary: true;
                min-width: 160px;
                clicked => { root.generate(); }
            }
        }

    }


    Rectangle {
        visible: root.snackbar-items.length > 0;
        width: min(360px, max(0px, root.width - Theme.spacing * 4));
        height: self.preferred-height;
        x: max(Theme.spacing * 2, root.width - self.width - Theme.spacing * 2);
        y: Theme.spacing * 2;
        background: transparent;

        VerticalBox {
            spacing: Theme.spacing;
            for i in root.snackbar-items.length : Snackbar {
                text: root.snackbar-items[root.snackbar-items.length - 1 - i].text;
                level: root.snackbar-items[root.snackbar-items.length - 1 - i].level;
                id: root.snackbar-items[root.snackbar-items.length - 1 - i].id;
                close-requested => { root.close-snackbar(self.id); }
            }
        }
    }

    if root.custom-open: ModalDialog {
        dialog-width: 420px;
        dialog-height: 210px;
        close => { root.custom-cancel(); }

        Text {
            text: "Dimensions personnalisées (mm)";
            font-weight: 600;
        }
        LineEdit {
            text <=> root.custom-width-mm;
        }
        LineEdit {
            text <=> root.custom-height-mm;
        }
        Text {
            text: (root.custom-error == "" ? "Tab entre les champs ; Valider confirme ; Annuler restaure." : root.custom-error);
            wrap: word-wrap;
            font-size: Theme.font-secondary;
        }
        Rectangle {
            vertical-stretch: 1;
        }
        PopupButtonRow {
            Button {
                text: "Annuler";
                clicked => { root.custom-cancel(); }
            }
            Button {
                text: "Valider";
                primary: true;
                clicked => { root.custom-confirm(); }
            }
        }
    }

    if root.save-open: ModalDialog {
        dialog-width: 420px;
        dialog-height: 160px;
        close => { root.save-open = false; root.preset-save-error = ""; }

        Text {
            text: "Enregistrer le format actuel";
            font-weight: 600;
        }
        LineEdit {
            text <=> root.preset-name-text;
        }
        Text {
            text: (root.preset-save-error == "" ? "Nom du préréglage (Entrée ou Valider)." : root.preset-save-error);
            wrap: word-wrap;
            font-size: Theme.font-secondary;
        }
        Rectangle {
            vertical-stretch: 1;
        }
        PopupButtonRow {
            Button {
                text: "Annuler";
                clicked => { root.save-open = false; root.preset-save-error = ""; }
            }
            Button {
                text: "Valider";
                primary: true;
                clicked => { root.save-preset-confirm(); }
            }
        }
    }

    if root.delete-open: ModalDialog {
        dialog-width: 420px;
        dialog-height: 140px;
        close => { root.delete-open = false; root.delete-preset-error = ""; }

        Text {
            text: "Supprimer le format « " + root.delete-preset-name + " » ?";
            wrap: word-wrap;
            font-weight: 600;
        }
        Text {
            text: (root.delete-preset-error == "" ? "Cette action est irréversible." : root.delete-preset-error);
            wrap: word-wrap;
            font-size: Theme.font-secondary;
            color: root.delete-preset-error == "" ? Palette.alternate-foreground : #e53935;
        }
        Rectangle {
            vertical-stretch: 1;
        }
        PopupButtonRow {
            Button {
                text: "Annuler";
                clicked => { root.delete-open = false; root.delete-preset-error = ""; }
            }
            Button {
                text: "Supprimer";
                primary: true;
                clicked => { root.delete-preset-confirm(); }
            }
        }
    }

    }

    changed sheet-index => { if (!root.sheet-selection-lock) { root.sheet-selection-changed(root.sheet-index); } root.refresh-preview(); }
    changed sheet-width-mm => { root.refresh-preview(); }
    changed sheet-height-mm => { root.refresh-preview(); }
    changed sheet-orientation-index => { root.refresh-preview(); }
    changed rotate-verso => { root.refresh-preview(); }
    changed bleed-text => { root.refresh-preview(); }
    changed safety-text => { root.refresh-preview(); }
    changed rotate-copies => { root.refresh-preview(); }
}